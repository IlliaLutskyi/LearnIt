generator client {
  provider   = "prisma-client-js"
  output     = "./generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  password       String
  email          String          @unique
  sectionRatings SectionRating[]
  role           Role            @default(User)
  courses        Course[]
}

model Course {
  id            Int            @id @default(autoincrement())
  poster        String
  title         String         @unique
  slug          String         @unique
  description   String
  sectionGroups SectionGroup[]
  prerequisites Prerequisit[]
  skills        Skill[]
  categoryId    Int
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  courses     Course[]
  description String
  image       String
}

model SectionGroup {
  id               Int       @id @default(autoincrement())
  title            String
  slug             String
  showSectionsOnly Boolean   @default(false)
  sections         Section[]
  order            Int
  courseId         Int
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Section {
  id             Int             @id @default(autoincrement())
  lessons        Lesson[]
  title          String
  slug           String
  order          Int
  sectionRates   SectionRating[]
  sectionGroupId Int
  sectionGroup   SectionGroup    @relation(fields: [sectionGroupId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          Int          @id @default(autoincrement())
  title       String
  content     String?
  quiz        Quiz?
  order       Int
  quizId      Int?
  codeStyle   String?
  contentType ContentType
  videoSource VideoSource?
  sectionId   Int
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Quiz {
  id          Int      @id() @default(autoincrement())
  answers     Answer[]
  question    String
  explanation String?
  lessonId    Int      @unique
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Answer {
  id        Int     @id() @default(autoincrement())
  quizId    Int
  quiz      Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  content   String
  isCorrect Boolean
}

model Prerequisit {
  id       Int    @id() @default(autoincrement())
  content  String
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Skill {
  id       Int    @id() @default(autoincrement())
  content  String
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model SectionRating {
  id        Int      @id() @default(autoincrement())
  rate      Int      @default(0)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId Int
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sectionId])
}

enum Role {
  Admin
  User
}

enum VideoSource {
  Youtube
}

enum ContentType {
  Video
  Text
  Quiz
  Markdown
  Table
  Image
  HighlightedCode
}
